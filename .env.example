# Database — all passwords are required by docker-compose (no built-in defaults).
DB_ROOT_PASSWORD=change_me_root
DB_HOST=buchhaltung-db-local
DB_PORT=3307
# Owner user of the database (created by the MariaDB image, full rights on the database). Used
# only by the one-shot `migrate` service, never by the running app.
DB_USER=fsi
DB_PASSWORD=change_me_db
DB_NAME=fsi_buchhaltung
DB_CONN_LIMIT=5

# Restricted user the running app connects as: data access only, no DDL / triggers
# (scripts/create-runtime-db-user.mjs, run by the `migrate` service). Must differ from DB_USER.
# Outside docker-compose (npm run dev) point DB_USER/DB_PASSWORD at these values once created.
DB_RUNTIME_USER=fsi_app
DB_RUNTIME_PASSWORD=change_me_runtime

# Optional: separate privileged credentials for database setup tasks
# such as migrations that ALTER tables and audit trigger/table creation.
# Leave unset to reuse DB_USER / DB_PASSWORD. With root, use the same value as DB_ROOT_PASSWORD.
DB_AUDIT_SETUP_USER=root
DB_AUDIT_SETUP_PASSWORD=change_me_root

# Cash register connection (Kassensystem)
# connected: shows the cash register tab on events, filled by the kassensystem's
# integration API (called from this server, never from the browser).
CASH_REGISTER_MODE=standalone   # standalone/connected
# Base URL of the kassensystem including its APP_BASE_URL path.
CASH_REGISTER_API_URL=http://kasse-app:3001
# Same value as the kassensystem's INTEGRATION_API_KEY (at least 32 characters).
CASH_REGISTER_API_KEY=
CASH_REGISTER_API_TIMEOUT_MS=10000

# Restricted DB user for the kassensystem connection, created in THIS database
# by "npm run setup:connection-db-user" (SELECT on users/permissions/members/
# events plus the sessions table). Point the kassensystem's ACCOUNTING_DB_USER/
# ACCOUNTING_DB_PASSWORD at these credentials.
CONNECTION_DB_USER=fsi_buchhaltung_connect
CONNECTION_DB_PASSWORD=change_me_connection

# Session / auth
# Set COOKIE_DOMAIN to the shared parent domain (e.g. .example.com) when the
# buchhaltung and kassensystem run on separate subdomains and SSO is desired.
# Leave unset for single-origin deployments — behaviour is identical without it.
COOKIE_DOMAIN=
SESSION_COOKIE_NAME=fsi_session_db
# At least 32 random characters (e.g. `openssl rand -hex 32`); the app refuses to start in production otherwise.
SESSION_SECRET=replace_me_with_random
SESSION_INACTIVITY_MINUTES=30
SESSION_MAX_AGE_MINUTES=1440
# Set to true only when the app is reachable exclusively through a reverse proxy that sets
# X-Forwarded-For. Login rate limits are per client IP; trusting the header without such a proxy
# lets clients fake their IP and bypass the limits. Limits are kept in memory (single instance).
TRUST_PROXY=false
# Session cookie 'Secure' flag; defaults to true when NODE_ENV=production. Set true whenever the app
# is served over HTTPS. Note: with COOKIE_DOMAIN every subdomain of it is trusted with the session
# cookie (and counts as same-site), so only share it with hosts you control.
COOKIE_SECURE=
# Absolute public URL of the app incl. APP_BASE_URL path (e.g. https://fsi.example.com/buchhaltung).
# Used for links in e-mails (unsubscribe, one-click List-Unsubscribe header).
APP_PUBLIC_URL=
# Key that signs database snapshots (HMAC). Restoring a snapshot that was not signed with this key
# (another server, or created before signing existed) needs an explicit confirmation. Defaults to a
# key derived from SESSION_SECRET — set it explicitly if SESSION_SECRET may ever be rotated.
SNAPSHOT_SIGNING_KEY=
# Security headers: the Content-Security-Policy is sent report-only until CSP_ENFORCE=true (check the
# browser console for violations first). ENABLE_HSTS=true only when the app is served over HTTPS.
CSP_ENFORCE=false
ENABLE_HSTS=false
# Optional: hosts web push endpoints may point to (comma-separated, *.domain for subdomains).
# Default: the Google, Mozilla, Microsoft and Apple push services.
PUSH_ENDPOINT_HOSTS=

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# Nuxt runtime
HOST=0.0.0.0
PORT=3002
APP_BASE_URL=/

# Time zone
# Only seeds the "app_time_zone" setting on first migration (scripts/migrate-explicit-time-zones.mjs).
# Afterwards it is changed under Settings → App; this variable is not read at runtime.
APP_TIME_ZONE=Europe/Berlin

# Files
MAX_UPLOAD_MB=5
# Request bodies are size-checked before they are read: uploads may be MAX_UPLOAD_MB + 1 MB, JSON
# 4 MB, snapshot restore uploads MAX_SNAPSHOT_UPLOAD_MB. Set the reverse proxy limit accordingly
# (nginx: client_max_body_size, at least MAX_SNAPSHOT_UPLOAD_MB if restores go through the proxy).
MAX_SNAPSHOT_UPLOAD_MB=1024
UPLOAD_DIR=/

# Notifications
NOTIFICATIONS_DISPATCH_DISABLED=false   # true disables the background dispatcher (e.g. for a second instance)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
# Phase 4 (web push) — generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vorstand@example.com
