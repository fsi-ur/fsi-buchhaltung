{
  "name": "fsi-portal",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tests.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:db": "vitest run --config vitest.config.db.ts",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:setup": "node scripts/setup-test-db.mjs",
    "test:db:reset": "node scripts/setup-test-db.mjs --reset",
    "test:all": "npm run typecheck && npm run test && npm run test:db",
    "setup:migrate": "node --env-file=.env scripts/migrate-event-cost-centre-splits.mjs",
    "setup:migrate:invoice-paid-at": "node --env-file=.env scripts/migrate-invoice-paid-at.mjs",
    "setup:migrate:invoice-position-description": "node --env-file=.env scripts/migrate-invoice-position-description-nullable.mjs",
    "setup:migrate:app-settings": "node --env-file=.env scripts/migrate-app-settings.mjs",
    "setup:migrate:cash-count-register-checks": "node --env-file=.env scripts/migrate-cash-count-register-checks.mjs",
    "setup:migrate:password-change-required": "node --env-file=.env scripts/migrate-user-password-change-required.mjs",
    "setup:migrate:event-planning": "node --env-file=.env scripts/migrate-event-planning.mjs",
    "setup:migrate:checklist-task-link": "node --env-file=.env scripts/migrate-checklist-task-link.mjs",
    "setup:migrate:bank-statements": "node --env-file=.env scripts/migrate-bank-statements.mjs",
    "setup:migrate:shift-templates": "node --env-file=.env scripts/migrate-shift-templates.mjs",
    "setup:migrate:calendar-token": "node --env-file=.env scripts/migrate-calendar-token.mjs",
    "setup:migrate:member-self-service": "node --env-file=.env scripts/migrate-member-self-service.mjs",
    "setup:migrate:notifications": "node --env-file=.env scripts/migrate-notifications.mjs",
    "setup:migrate:audit-log": "node --env-file=.env scripts/migrate-audit-log.mjs",
    "setup:migrate:wiki": "node --env-file=.env scripts/migrate-wiki.mjs",
    "setup:migrate:appointments": "node --env-file=.env scripts/migrate-appointments.mjs",
    "setup:migrate:association-documents": "node --env-file=.env scripts/migrate-association-documents.mjs",
    "setup:seed:wiki-content": "node --env-file=.env scripts/migrate-wiki.mjs --seed-content",
    "setup:seed-admin": "node --env-file=.env scripts/seed-admin.mjs",
    "setup:audit": "node --env-file=.env scripts/ensure-audit-infrastructure.mjs",
    "setup:prune:audit-log": "node --env-file=.env scripts/prune-audit-log.mjs",
    "setup:connection-db-user": "node --env-file=.env scripts/create-connection-db-user.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/material-symbols": "^1.2.76",
    "@nuxt/icon": "^2.1.1",
    "@tailwindcss/vite": "^4.1.13",
    "@vite-pwa/nuxt": "^1.0.4",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.5",
    "markdown-it": "^15.0.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-container": "^4.0.0",
    "nodemailer": "^9.0.5",
    "nuxt": "^4.0.3",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.1.17",
    "vue": "^3.5.20",
    "vue-pdf-embed": "^2.1.3",
    "vue-router": "^4.5.1",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "ansi-regex": "^6.0.1",
    "ansi-styles": "^6.2.1",
    "color-name": "^1.1.4",
    "supports-color": "^9.0.0",
    "strip-ansi": "^7.1.0",
    "string-width": "^5.1.2",
    "wrap-ansi": "^9.0.0",
    "cliui": "^8.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "typescript": "~5.9",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}
